<?xml version="1.0"?>
<sdf version="1.7">
  <model name="test_tube">
    <!-- Link origin is the bottom of the tube. Cylinder length 0.12, radius 0.012. -->
    <link name="body">
      <inertial>
        <pose>0 0 0.06 0 0 0</pose>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.0001</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.0001</iyy><iyz>0</iyz>
          <izz>0.00005</izz>
        </inertia>
      </inertial>
      <visual name="visual">
        <pose>0 0 0.06 0 0 0</pose>
        <geometry>
          <cylinder><radius>0.012</radius><length>0.12</length></cylinder>
        </geometry>
        <material><diffuse>0.65 0.90 0.98 0.55</diffuse></material>
      </visual>
      <collision name="collision">
        <pose>0 0 0.06 0 0 0</pose>
        <geometry>
          <cylinder><radius>0.012</radius><length>0.12</length></cylinder>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>
