<?xml version="1.0"?>
<sdf version="1.7">
  <model name="boiling_flask">
    <!-- Link origin is the contact point under the sphere, so the flask sits on the holder. -->
    <link name="body">
      <inertial>
        <pose>0 0 0.06 0 0 0</pose>
        <mass>0.2</mass>
        <inertia>
          <ixx>0.0005</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.0005</iyy><iyz>0</iyz>
          <izz>0.0003</izz>
        </inertia>
      </inertial>
      <visual name="body">
        <pose>0 0 0.045 0 0 0</pose>
        <geometry>
          <sphere><radius>0.045</radius></sphere>
        </geometry>
        <material><diffuse>0.65 0.90 0.98 0.55</diffuse></material>
      </visual>
      <collision name="body">
        <pose>0 0 0.045 0 0 0</pose>
        <geometry>
          <sphere><radius>0.045</radius></sphere>
        </geometry>
      </collision>
      <visual name="neck">
        <pose>0 0 0.13 0 0 0</pose>
        <geometry>
          <cylinder><radius>0.018</radius><length>0.08</length></cylinder>
        </geometry>
        <material><diffuse>0.65 0.90 0.98 0.55</diffuse></material>
      </visual>
      <collision name="neck">
        <pose>0 0 0.13 0 0 0</pose>
        <geometry>
          <cylinder><radius>0.018</radius><length>0.08</length></cylinder>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>
